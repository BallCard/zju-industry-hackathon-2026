# 复制为 .env 并填入你自己的值。.env 已被 gitignore，绝不提交，绝不贴进截图/视频/README。
# 获取：用已加入共享知识库的同一 ima 账号打开 https://ima.qq.com/agent-interface
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=

# 大模型（手册：允许调用公开大模型服务）。按 docs/PROJECT.md 里选定的服务填写变量名与值。
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 共享知识库名称（用于 search_knowledge_base 查 kb_id；kb_id 属于内部标识，勿外泄、勿入库）
IMA_KB_NAME=任德耀新建华为PC知识库
