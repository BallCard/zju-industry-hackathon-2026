#!/usr/bin/env bash
# 1) 密钥/资料防泄露（始终执行，不可被 LANE_OVERRIDE 跳过）  2) 车道检查
root="$(git rev-parse --show-toplevel)"
fail=0
# 禁止提交的路径：真实凭证文件、举办方知识库副本、第三方 skill 副本
if git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)(\.env($|\.)|data/kb/|data/ref/|vendor/ima-skill/|.*\.(pem|key)$)' | grep -v '\.env\.example$' | grep .; then
  echo "↑ 这些路径不得提交（密钥/举办方资料/第三方副本）"; fail=1
fi
# 新增行里出现疑似 API Key / Client ID 赋值
if git diff --cached -U0 --no-color | grep -E '^\+' | grep -v '^+++' | grep -iE '(api_?key|client_?id|secret|token)[A-Za-z_]*["'"'"']?[[:space:]]*[=:][[:space:]]*["'"'"']?[A-Za-z0-9_+/=-]{16,}' | grep -v '<'; then
  echo "↑ 疑似写入了凭证。凭证只放环境变量/本地 .env，绝不入库（赛题硬性要求）"; fail=1
fi
[ $fail = 1 ] && exit 1
[ "${LANE_OVERRIDE:-}" = "1" ] && exit 0
me="$(git config hack.owner || true)"
[ -n "$me" ] || { echo "未设置 owner。先运行: bash scripts/setup.sh <name>"; exit 1; }
bad=0
while IFS= read -r f; do
  owner="$(awk -v f="$f" '
    /^[ \t]*#/ || NF<2 {next}
    { p=$1; if (index(f,p)==1 && length(p)>=best) {best=length(p); o=$2} }
    END {print o}' "$root/OWNERS")"
  if [ -n "$owner" ] && [ "$owner" != "*" ] && [ "$owner" != "$me" ]; then
    echo "越界: $f 属于 $owner（你是 $me）"; bad=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMRD)
if [ $bad = 1 ]; then
  echo "请让对应车道的 agent 改，或在 docs/tasks 里留言；确需越界: LANE_OVERRIDE=1 git commit"
  exit 1
fi
