# Copy this file into your environment. NEVER put actual credentials in Git.
HOST=127.0.0.1
PORT=8765
# local is default even when ima credentials exist; switch to live only when ready to verify.
DEFAULT_DATA_MODE=local
LOCAL_KB_ROOT=
IMA_KB_NAME=任德耀新建华为PC知识库
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
