# Without these settings, the UI explicitly uses local intent parsing and KB-based recommendations.
# Set them as environment variables / platform Secrets, not in Git.
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_MODEL=
# LLM_API_KEY=
